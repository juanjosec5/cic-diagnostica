---
// Google Analytics 4: loads only after the visitor accepts in the consent banner, and only on the production host
// (analytics in src/data/site.ts). Before that, nothing from Google loads and track() does nothing.
// See README > Analytics for the events, and README > Privacy and consent.
---

<script>
  import { analytics } from '../data/site';
  import { whenConsentGranted } from '../lib/consent';
  import { track } from '../lib/track';

  whenConsentGranted(() => {
    if (location.hostname !== analytics.host) return;
    window.dataLayer = window.dataLayer || [];
    // gtag must push the arguments object itself, not an array: that's what gtag.js reads.
    window.gtag = function gtag() {
      window.dataLayer!.push(arguments);
    };
    window.gtag('js', new Date());
    // No ads features: no Google signals, no ad personalization (they would need more consent).
    window.gtag('config', analytics.measurementId, { allow_google_signals: false, allow_ad_personalization_signals: false });
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(analytics.measurementId)}`;
    document.head.append(script);
  });

  /** Which button produced the lead: its data-track, else the page section it's in. */
  function leadLocation(link: HTMLElement) {
    if (link.dataset.track) return link.dataset.track;
    const section = link.closest<HTMLElement>('section[id]');
    if (section) return section.id;
    if (link.closest('header')) return 'header';
    return link.closest('footer') ? 'footer' : 'otro';
  }

  // Every WhatsApp button on the site is a lead. The catalog's send buttons report themselves (with the products),
  // and a click another handler cancelled (e.g. "Cotizar" opening the list instead) didn't open WhatsApp.
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="https://wa.me/"]');
    if (!link || e.defaultPrevented || link.matches('[data-send]')) return;
    track('generate_lead', { method: 'whatsapp', location: leadLocation(link) });
  });
</script>
