# Resend API key (https://resend.com/api-keys). Server-side only, never exposed to the browser.
# Leave empty in local development to mock sends (the email is logged to the terminal).
RESEND_API_KEY=

# Inbox that receives the form submissions. Comma-separate for several addresses.
CONTACT_TO=ventas@example.com

# Sender. Until your domain is verified in Resend, use onboarding@resend.dev
# (it can only deliver to the email address you signed up to Resend with).
CONTACT_FROM="CIC Diagnostica <onboarding@resend.dev>"
