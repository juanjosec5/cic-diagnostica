---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Plans from '../components/Plans.astro';
import BestSellers from '../components/BestSellers.astro';
import Products from '../components/Products.astro';
import Contracts from '../components/Contracts.astro';
import Coverage from '../components/Coverage.astro';
import Contact from '../components/Contact.astro';
import SupplierDocs from '../components/SupplierDocs.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { deliveryTime, municipalities } from '../data/site';

// Worded like the searches buyers type (product line + Buga / Valle del Cauca). Title ≤ 60 chars, description ≤ 160.
const title = 'Insumos médicos y de laboratorio en Buga | CIC Diagnóstica';
const description = `Insumos médicos y de laboratorio sin pedido mínimo. Entrega gratis en ${municipalities.length} municipios del Valle del Cauca, en ${deliveryTime}. Cotice por WhatsApp.`;
---

<Layout title={title} description={description}>
  <Header />
  <main id="main">
    <Hero />
    <BestSellers />
    <Products />
    <Coverage />
    <Plans />
    <Contracts />
    <SupplierDocs />
    <Testimonials />
    <Faq />
    <!-- Contact last: the page ends on the action. -->
    <Contact />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
