---
import Icon from './Icon.astro';
import { productCategories } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<section id="productos" class="section section--soft">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Productos</span>
      <h2>Lo que su laboratorio necesita, en un solo proveedor</h2>
      <p class="lead">Estas son algunas de nuestras líneas. Consulte el catálogo completo con precios.</p>
    </div>

    <ul class="grid">
      {productCategories.map((cat) => (
        <li class="card">
          <span class="icon-badge"><Icon name={cat.icon} /></span>
          <h3>{cat.title}</h3>
          <ul class="items">
            {cat.items.map((item) => <li>{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <div class="notice">
      <div class="notice__copy">
        <h3>Reciba el catálogo con precios</h3>
        <p>
          Aún no tenemos tienda en línea. Pídanos el catálogo por WhatsApp o por correo y le enviamos los precios
          junto con una cotización según sus cantidades.
        </p>
      </div>
      <div class="notice__actions">
        <a class="btn btn--wa" href={waLink('catalog')} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={22} />
          Reciba el catálogo con precios
        </a>
        <a class="btn btn--outline" href="#contacto" data-interest="catalogo">Pedirlo por correo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  .items li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green-600);
  }

  .notice {
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem 2rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: var(--radius);
    background: var(--green-50);
    border: 1px solid var(--green-line);
  }

  @media (min-width: 960px) {
    .notice {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .notice h3 {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }

  .notice p {
    margin: 0;
    color: var(--muted);
    max-width: 560px;
  }

  .notice__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .notice__actions .btn {
    flex: 1 1 240px;
  }

  @media (min-width: 640px) {
    .notice__actions .btn {
      flex: 0 0 auto;
    }
  }
</style>
