---
import Icon from './Icon.astro';
import { contractBenefits, contractSteps } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<section id="contratos" class="section contracts">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Contratos de suministro</span>
      <h2>Pensados para hospitales e IPS</h2>
    </div>

    <ul class="benefits">
      {contractBenefits.map((b) => (
        <li class="benefit">
          <span class="benefit__icon"><Icon name={b.icon} /></span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))}
    </ul>

    <h3 class="steps__title">Cómo funciona</h3>
    <ol class="steps">
      {contractSteps.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{i + 1}</span>
          <div>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="contracts__cta">
      <a class="btn btn--wa" href={waLink('contract')} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} />
        Hablar con un asesor
      </a>
      <a class="btn btn--light" href="#contacto" data-interest="contrato">
        Solicitar propuesta
        <Icon name="arrow" size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  .contracts {
    background: linear-gradient(180deg, var(--blue-900), var(--blue-800));
    color: #e6eef7;
  }

  .contracts h2,
  .contracts h3,
  .contracts h4 {
    color: #fff;
  }

  .contracts .eyebrow {
    color: var(--sky-light);
  }

  /* 2×2 on every width; one row on desktop. */
  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  @media (min-width: 1000px) {
    .benefits {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
  }

  .benefit {
    padding: 0.9rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.14);
  }

  .benefit__icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 0.6rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--sky-light) 15%, transparent);
    color: var(--sky-light);
  }

  .benefit h3 {
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .benefit p {
    margin: 0;
    color: #c9d8e8;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .steps__title {
    margin-top: 2rem;
    font-size: 1.2rem;
  }

  .steps {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }
  }

  .step {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
  }

  .step h4 {
    color: var(--blue-900);
    font-size: 1rem;
    margin: 0.2rem 0 0.15rem;
  }

  .step p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .step__num {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--green-700);
    color: #fff;
    font-weight: 800;
  }

  .contracts__cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .contracts__cta .btn {
    flex: 1 1 260px;
  }

  .btn--light {
    background: transparent;
    color: #fff;
    border-color: rgb(255 255 255 / 0.6);
  }

  .btn--light:hover {
    background: rgb(255 255 255 / 0.1);
  }

  .contracts__cta .btn:focus-visible {
    outline-color: var(--sky-light);
  }

  @media (min-width: 640px) {
    .contracts__cta .btn {
      flex: 0 0 auto;
    }
  }
</style>
