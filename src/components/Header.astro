---
import Icon from './Icon.astro';
import { company, navLinks } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<header class="header">
  <div class="urgent">
    <div class="container urgent__inner">
      <!-- Short copy on phones so the bar stays on one line. -->
      <span class="urgent__text">
        <span class="wide">¿Se está quedando sin insumos?</span>
        <span class="narrow">¿Sin insumos?</span>
      </span>
      <a href={waLink('urgent')} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={16} />
        <span class="wide">Pedidos urgentes por WhatsApp</span>
        <span class="narrow">Pedido urgente</span>
      </a>
    </div>
  </div>

  <div class="container header__inner">
    <a href="#inicio" class="logo" aria-label={`${company.name}, ir al inicio`}>
      <!-- Interim mark cropped from the PNG logo; swap for the final SVG when it arrives. -->
      <img class="logo__mark" src="/brand/mark.png" width="40" height="40" alt="" />
      <span class="logo__text" aria-hidden="true">
        diagnóstica
        <span class="logo__sub">cic</span>
      </span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul id="nav-list" class="nav__list">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--wa header__wa" href={waLink('quote')} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={20} />
      <span>Cotizar</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list" aria-label="Abrir menú">
      <span class="nav-toggle__open"><Icon name="menu" /></span>
      <span class="nav-toggle__close"><Icon name="close" /></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const list = document.getElementById('nav-list');
  if (toggle && list) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      list.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && list.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .urgent {
    background: var(--blue-900);
    color: #e6eef7;
    font-size: 0.875rem;
  }

  .urgent__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.75rem;
    min-height: var(--urgent-h);
  }

  .urgent__text,
  .urgent a {
    white-space: nowrap;
  }

  .urgent .wide {
    display: none;
  }

  @media (min-width: 640px) {
    .urgent .wide {
      display: inline;
    }
    .urgent .narrow {
      display: none;
    }
  }

  .urgent a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-block: 0.4rem;
    color: #fff;
    font-weight: 700;
  }

  .urgent a :global(svg) {
    color: var(--sky-light);
  }

  .urgent a:focus-visible {
    outline-color: var(--sky-light);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--blue-900);
    margin-right: auto;
  }

  .logo__mark {
    flex: none;
    border-radius: 50%;
  }

  /* Mirrors the logo lockup: lowercase "diagnóstica" with a small "cic" below, right-aligned. */
  .logo__text {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .logo__sub {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--blue-700);
  }

  .logo__sub::before {
    content: '';
    width: 0.9rem;
    height: 2px;
    border-radius: 2px;
    background: var(--sky);
  }

  .header__wa {
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    font-size: 0.95rem;
  }

  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    color: var(--blue-900);
    cursor: pointer;
  }

  .nav-toggle__close,
  .nav-toggle[aria-expanded='true'] .nav-toggle__open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__close {
    display: inline;
  }

  .nav__list {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.5rem 16px 1rem;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .nav__list.is-open {
    display: block;
  }

  .nav__list a {
    display: block;
    padding: 0.75rem 0.25rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .nav__list li:last-child a {
    border-bottom: 0;
  }

  /* Phones show only the round mark; the wordmark needs more width than the header has. */
  @media (max-width: 639px) {
    .logo__text {
      display: none;
    }
  }

  @media (min-width: 1040px) {
    .nav-toggle {
      display: none;
    }

    .nav__list {
      display: flex;
      gap: 0.25rem;
      position: static;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .nav__list a {
      padding: 0.5rem 0.75rem;
      border: 0;
      border-radius: 8px;
      font-size: 0.95rem;
    }

    .nav__list a:hover {
      background: var(--blue-50);
      color: var(--blue-700);
    }
  }
</style>
