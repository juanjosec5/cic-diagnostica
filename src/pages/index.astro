---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Plans from '../components/Plans.astro';
import BestSellers from '../components/BestSellers.astro';
import Products from '../components/Products.astro';
import Contracts from '../components/Contracts.astro';
import Coverage from '../components/Coverage.astro';
import Contact from '../components/Contact.astro';
import SupplierDocs from '../components/SupplierDocs.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const title = 'CIC Diagnóstica | Insumos de laboratorio en el suroccidente colombiano';
const description =
  'Reactivos e insumos de laboratorio en el suroccidente colombiano: entregas propias en el Valle del Cauca y contratos para hospitales e IPS a 30 a 45 días.';
---

<Layout title={title} description={description}>
  <Header />
  <main id="main">
    <Hero />
    <BestSellers />
    <Products />
    <Plans />
    <Contracts />
    <Coverage />
    <Contact />
    <SupplierDocs />
    <Testimonials />
    <Faq />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
