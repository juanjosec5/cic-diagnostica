---
import { PUBLIC_UMAMI_WEBSITE_ID } from 'astro:env/client';
// Analytics (Vercel Web Analytics + Umami Cloud) load only after the visitor accepts in the consent banner.
// See README > Tracking for the event list and docs/privacy-plan.md for the consent rules.
---

<div id="analytics-config" data-umami-id={PUBLIC_UMAMI_WEBSITE_ID ?? ''} hidden></div>

<script>
  import { inject } from '@vercel/analytics';
  import { whenConsentGranted } from '../lib/consent';

  whenConsentGranted(() => {
    inject({ framework: 'astro' });
    const umamiId = document.getElementById('analytics-config')?.dataset.umamiId;
    if (umamiId) {
      const script = document.createElement('script');
      script.defer = true;
      script.src = 'https://cloud.umami.is/script.js';
      script.dataset.websiteId = umamiId;
      document.head.append(script);
    }
  });
</script>

<script>
  import { whatsappMessages } from '../data/site';
  import { track } from '../lib/analytics';

  // Every WhatsApp link carries one of the configured messages, so the message identifies the button intent.
  const intentByMessage = new Map<string, string>(
    Object.entries(whatsappMessages).map(([intent, text]) => [text, intent]),
  );

  const sectionOf = (el: Element): string => {
    const container = el.closest<HTMLElement>('.wa-float, section[id], header, footer');
    if (!container) return 'page';
    if (container.matches('.wa-float')) return 'floating';
    return container.id || container.tagName.toLowerCase();
  };

  // innerText skips copy hidden at this screen size (e.g. the urgent bar's short/long variants).
  const labelOf = (a: HTMLAnchorElement): string =>
    a.innerText.replace(/\s+/g, ' ').trim().slice(0, 60) || a.getAttribute('aria-label') || '';

  // One delegated listener covers every link and CTA, including ones added later.
  document.addEventListener('click', (event) => {
    const a = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!a || a.classList.contains('skip-link')) return;

    const href = a.getAttribute('href') ?? '';
    const section = sectionOf(a);

    if (href.startsWith('https://wa.me/c/')) {
      track('catalog_view', { section, label: labelOf(a) });
    } else if (href.startsWith('https://wa.me/')) {
      const text = new URL(href).searchParams.get('text') ?? '';
      track('whatsapp_click', { intent: intentByMessage.get(text) ?? 'unknown', section, label: labelOf(a) });
    } else if (href.startsWith('mailto:')) {
      track('email_click', { section });
    } else if (href.startsWith('#')) {
      track(a.closest('nav') ? 'nav_click' : 'cta_click', {
        target: href.slice(1),
        section,
        label: labelOf(a),
        ...(a.dataset.interest && { interest: a.dataset.interest }),
      });
    } else {
      track('outbound_click', { url: href, section });
    }
  });

  // `toggle` doesn't bubble, so listen in the capture phase.
  document.addEventListener(
    'toggle',
    (event) => {
      const details = event.target;
      if (details instanceof HTMLDetailsElement && details.open) {
        track('faq_open', { question: details.querySelector('summary')?.textContent?.trim() ?? '' });
      }
    },
    true,
  );
</script>
