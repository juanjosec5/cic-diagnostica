---
import Icon from './Icon.astro';
import { productCategories } from '../data/site';
import { waCatalogLink } from '../lib/whatsapp';
---

<section id="productos" class="section section--soft">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Productos</span>
      <h2>Lo que su laboratorio necesita, con un solo proveedor</h2>
      <p class="lead">Algunas de nuestras líneas. El catálogo completo está en WhatsApp.</p>
    </div>

    <!-- Phones: a horizontal swipe row (CSS scroll-snap, no JS). Wider screens: a grid. -->
    <ul class="track" tabindex="0" aria-label="Líneas de producto">
      {productCategories.map((cat) => (
        <li class="card product">
          <span class="icon-badge"><Icon name={cat.icon} /></span>
          <h3>{cat.title}</h3>
          <ul class="items">
            {cat.items.map((item) => <li>{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <p class="swipe-hint" aria-hidden="true">Deslice para ver más <Icon name="arrow" size={16} /></p>

    <div class="catalog">
      <p>Ábralo en el chat y pídanos su cotización.</p>
      <a class="btn btn--wa" href={waCatalogLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} />
        Ver catálogo
      </a>
    </div>
  </div>
</section>

<style>
  .track {
    list-style: none;
    margin: 0 -16px;
    padding: 0.25rem 16px 0.75rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline-offset: -3px;
  }

  .product {
    scroll-snap-align: start;
    padding: 1.1rem;
  }

  .product h3 {
    margin-bottom: 0.6rem;
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .items li {
    position: relative;
    padding-left: 0.9rem;
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green-600);
  }

  .swipe-hint {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem;
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (min-width: 640px) {
    .track {
      margin: 0;
      padding: 0;
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      overflow: visible;
    }

    .swipe-hint {
      display: none;
    }
  }

  .catalog {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--green-50);
    border: 1px solid var(--green-line);
  }

  .catalog p {
    margin: 0;
    font-weight: 600;
  }

  .catalog .btn {
    flex: 1 1 240px;
  }

  @media (min-width: 640px) {
    .catalog .btn {
      flex: 0 0 auto;
    }
  }
</style>
