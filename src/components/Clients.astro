---
import Icon from './Icon.astro';
import { clientTypes } from '../data/site';
---

<section id="clientes" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">A quién atendemos</span>
      <h2>Un proveedor para cada tipo de cliente</h2>
      <p class="lead">Desde hospitales con consumo mensual alto hasta consultorios que compran unas cajas al mes.</p>
    </div>

    <ul class="grid">
      {clientTypes.map((c) => (
        <li class="card">
          <span class="icon-badge"><Icon name={c.icon} /></span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card p {
    color: var(--muted);
    margin: 0;
  }
</style>
