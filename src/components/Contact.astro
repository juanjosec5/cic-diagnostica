---
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import { company } from '../data/site';
import { waLink } from '../lib/whatsapp';

// Google Maps without an API key: an embed (lazy-loaded near the viewport) and a directions link.
const mapsQuery = encodeURIComponent(`${company.address}, Colombia`);
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapsQuery}`;
const embedUrl = `https://www.google.com/maps?q=${mapsQuery}&output=embed`;
---

<section id="contacto" class="section section--soft">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Contacto</span>
      <h2>Cuéntenos qué necesita</h2>
      <p class="lead">Le respondemos en menos de {company.responseTime}.</p>
    </div>

    <div class="contact">
      <aside class="info">
        <a class="btn btn--wa info__wa" href={waLink('general')} target="_blank" rel="noopener" data-wa-primary>
          <Icon name="whatsapp" size={22} />
          Escribir por WhatsApp
        </a>

        <dl>
          <div class="row">
            <dt><Icon name="whatsapp" size={20} /><span>WhatsApp</span></dt>
            <dd>{company.whatsappDisplay}</dd>
          </div>
          <div class="row">
            <dt><Icon name="mail" size={20} /><span>Correo</span></dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div class="row">
            <dt><Icon name="map" size={20} /><span>Dirección</span></dt>
            <dd>{company.address}</dd>
          </div>
          <div class="row">
            <dt><Icon name="clock" size={20} /><span>Horario</span></dt>
            <dd>{company.hours.map((h) => <span class="line">{h}</span>)}</dd>
          </div>
        </dl>

        <div class="map">
          <div class="map__frame">
            <iframe
              src={embedUrl}
              title="Mapa: ubicación de CIC Diagnóstica"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
          </div>
          <a class="link-action" href={directionsUrl} target="_blank" rel="noopener">
            Cómo llegar <Icon name="arrow" size={18} />
          </a>
        </div>
      </aside>

      <div class="card form-card">
        <ContactForm />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 960px) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: 2.5rem;
    }
  }

  .info__wa {
    width: 100%;
    margin-bottom: 1.5rem;
  }

  dl {
    margin: 0;
    display: grid;
    gap: 1.1rem;
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--blue-900);
  }

  dt :global(svg) {
    color: var(--green-700);
  }

  dd {
    margin: 0.15rem 0 0 1.75rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .line {
    display: block;
  }

  .form-card {
    padding: clamp(1.1rem, 4vw, 2rem);
  }

  .map {
    margin-top: 1.5rem;
  }

  .map__frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--blue-50);
  }

  .map__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
