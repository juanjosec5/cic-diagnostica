---
import Icon from './Icon.astro';
import { waLink } from '../lib/whatsapp';
---

<a class="wa-float" href={waLink('general')} target="_blank" rel="noopener" aria-label="Escríbanos por WhatsApp">
  <Icon name="whatsapp" size={30} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--wa);
    color: #fff;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
    transition: transform 0.15s;
  }

  .wa-float:hover {
    transform: scale(1.06);
  }

  .wa-float:focus-visible {
    outline: 3px solid var(--blue-900);
    outline-offset: 3px;
    border-radius: 50%;
  }
</style>
