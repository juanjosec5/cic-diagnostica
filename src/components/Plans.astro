---
import Icon from './Icon.astro';
import { clientPlans } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<section id="planes" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Planes por tipo de cliente</span>
      <h2>¿Qué tipo de cliente es usted?</h2>
    </div>

    <ul class="tiles">
      {clientPlans.map((plan) => (
        <li class="tile">
          <div class="tile__head">
            <span class="icon-badge"><Icon name={plan.icon} /></span>
            <h3>{plan.title}</h3>
          </div>
          <ul class="tile__list">
            {plan.benefits.map((b) => (
              <li>
                <Icon name="check" size={16} />
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <!-- One action for the whole section; the tiles are information, not buttons. -->
    <div class="plans__cta">
      <a class="btn btn--wa" href={waLink('quote')} target="_blank" rel="noopener" data-wa-primary>
        <Icon name="whatsapp" size={22} />
        Cotizar por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1040px) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .tile__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tile__head .icon-badge {
    margin: 0;
    flex: none;
  }

  .tile__head h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .tile__list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .tile__list li {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
  }

  .tile__list :global(svg) {
    flex: none;
    margin-top: 0.25rem;
    color: var(--green-700);
  }

  .plans__cta {
    margin-top: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .plans__cta .btn {
    flex: 1 1 100%;
  }

  @media (min-width: 640px) {
    .plans__cta .btn {
      flex: 0 0 auto;
    }
  }
</style>
