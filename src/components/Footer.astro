---
import { company } from '../data/site';
import { waLink } from '../lib/whatsapp';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <img class="footer__logo" src="/brand/logo-horizontal-on-dark-sm.png" width="177" height="36" alt={company.name} loading="lazy" />
      <p class="footer__name">{company.legalName}</p>
      <p>NIT {company.nit}</p>
      <p>Distribuidora de insumos médicos y de laboratorio · {company.region}, Colombia</p>
    </div>
    <ul class="footer__contact">
      <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
      <li><a href={waLink('general')} target="_blank" rel="noopener">WhatsApp {company.whatsappDisplay}</a></li>
    </ul>
  </div>
  <div class="container">
    <p class="footer__copy">© {year} {company.name}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--blue-900);
    color: #c9d8e8;
    padding: 2.5rem 0 6rem; /* bottom space keeps the floating button off the text */
    font-size: 0.95rem;
  }

  .footer p {
    margin: 0 0 0.25rem;
  }

  .footer__inner {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .footer__logo {
    display: block;
    margin-bottom: 1rem;
  }

  .footer__name {
    color: #fff;
    font-weight: 700;
  }

  .footer__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .footer a {
    color: #fff;
    overflow-wrap: anywhere;
  }

  .footer a:focus-visible {
    outline-color: var(--sky-light);
  }

  .footer__copy {
    margin-top: 1.5rem !important;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: 0.85rem;
  }
</style>
