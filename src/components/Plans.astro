---
import Icon from './Icon.astro';
import { clientPlans, municipalities } from '../data/site';
import { waTextLink } from '../lib/whatsapp';
---

<section id="clientes" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Condiciones por tipo de cliente</span>
      <h2>¿Qué tipo de cliente es usted?</h2>
    </div>

    <ul class="tiles" data-wa-clear>
      {clientPlans.map((plan) => (
        <li class="card tile">
          <div class="tile__head">
            <span class="icon-badge"><Icon name={plan.icon} /></span>
            <h3>{plan.title}</h3>
          </div>
          <p class="tile__desc">{plan.description}</p>
          <ul class="tile__list">
            {plan.benefits.map((b) => <li>{b}</li>)}
          </ul>
          <a class="tile__cta" href={waTextLink(plan.cta.message)} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} />
            {plan.cta.label}
          </a>
        </li>
      ))}
    </ul>

    <p class="plans__all">
      <Icon name="check" size={18} />
      <span>Para todos: sin pedido mínimo y entrega gratis en {municipalities.length} municipios.</span>
    </p>
  </div>
</section>

<style>
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1040px) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    padding: 1rem;
  }

  .tile__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tile__head .icon-badge {
    margin: 0;
    flex: none;
  }

  .tile__head h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .tile__desc {
    margin: 0.75rem 0 0;
    color: var(--ink);
  }

  .tile__list {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Same dot bullets as the product lines. */
  .tile__list li {
    position: relative;
    padding-left: 0.9rem;
  }

  .tile__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue-600);
  }

  /* A text link, not a button: four green buttons side by side would compete. */
  .tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    min-height: 44px;
    font-weight: 700;
    color: var(--wa-dark);
    text-decoration: none;
  }

  .tile__cta:hover {
    text-decoration: underline;
  }

  .plans__all {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    font-weight: 600;
    text-align: center;
  }

  .plans__all :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--green-700);
  }
</style>
