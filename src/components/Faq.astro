---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<section id="preguntas" class="section">
  <div class="container faq">
    <div class="section-head">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2>Lo que más nos preguntan</h2>
    </div>

    <div class="list">
      {faqs.map((item) => (
        <details class="item">
          <summary>
            <span>{item.q}</span>
            <Icon name="chevron" size={20} />
          </summary>
          <p>
            {item.a}
            {item.link && (
              <>
                {' '}
                {item.link.intent ? (
                  <a href={waLink(item.link.intent)} target="_blank" rel="noopener">{item.link.text}</a>
                ) : (
                  <a href={item.link.href}>{item.link.text}</a>
                )}
              </>
            )}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 820px;
  }

  .list {
    display: grid;
    gap: 0.75rem;
  }

  .item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    min-height: 56px;
    font-weight: 700;
    color: var(--blue-900);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: none;
    color: var(--blue-700);
    transition: transform 0.2s;
  }

  .item[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  summary:focus-visible {
    outline-offset: -3px;
    border-radius: var(--radius);
  }

  .item p {
    margin: 0;
    padding: 0 1.25rem 1.25rem;
    color: var(--muted);
  }
</style>
