---
import Icon from './Icon.astro';
import { contractBenefits, contractSteps } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<section id="contratos" class="section contracts">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Contratos de suministro</span>
      <h2>Para hospitales e IPS</h2>
    </div>

    <ul class="benefits">
      {contractBenefits.map((b) => (
        <li class="benefit">
          <span class="benefit__icon"><Icon name={b.icon} /></span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))}
    </ul>

    <h3 class="steps__title">Cómo funciona</h3>
    <ol class="steps">
      {contractSteps.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{i + 1}</span>
          <div>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="actions contracts__cta">
      <a class="btn btn--wa" href={waLink('contract')} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} />
        Hablar con un asesor
      </a>
      <a class="link-action link-action--light" href="#contacto" data-interest="contrato">
        Solicitar propuesta
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .contracts {
    background: linear-gradient(180deg, var(--blue-900), var(--blue-800));
    color: var(--on-dark);
  }

  .contracts h2,
  .contracts h3,
  .contracts h4 {
    color: #fff;
  }

  .contracts .eyebrow {
    color: var(--sky-light);
  }

  /* 2×2 on every width; one row on desktop. */
  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  @media (min-width: 1000px) {
    .benefits {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
  }

  .benefit {
    padding: 0.9rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.14);
  }

  .benefit__icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 0.6rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--sky-light) 15%, transparent);
    color: var(--sky-light);
  }

  .benefit h3 {
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .benefit p {
    margin: 0;
    color: var(--on-dark-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .steps__title {
    margin-top: 2rem;
    font-size: 1.2rem;
  }

  /* A timeline: numbers joined by a line, vertical on phones and horizontal from 768px. */
  .steps {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .step {
    position: relative;
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 15px;
    top: 38px;
    bottom: calc(-1.25rem + 6px);
    width: 2px;
    background: rgb(255 255 255 / 0.25);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .step {
      flex-direction: column;
      gap: 0.6rem;
    }

    .step:not(:last-child)::after {
      left: 44px;
      right: calc(-1.5rem + 6px);
      top: 15px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }

  .step h4 {
    color: #fff;
    font-size: 1rem;
    margin: 0.2rem 0 0.15rem;
  }

  .step p {
    margin: 0;
    color: var(--on-dark-muted);
    font-size: 0.9rem;
  }

  .step__num {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue-900);
    font-weight: 800;
  }

  .link-action--light {
    color: #fff;
  }

  .link-action--light:hover {
    color: var(--sky-light);
  }

  .contracts__cta :focus-visible {
    outline-color: var(--sky-light);
  }
</style>
