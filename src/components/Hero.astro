---
import Icon from './Icon.astro';
import { company, deliveryTime, stats } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<section id="inicio" class="hero">
  <div class="container">
    <div class="hero__copy">
      <!-- Phones show only the logo symbol, so the name goes here too. -->
      <span class="eyebrow">{company.name} · Distribuidora de insumos médicos y de laboratorio</span>
      <h1>Todo lo que necesita, con un solo proveedor</h1>
      <p class="lead">
        Reactivos, toma de muestras, pruebas rápidas, consumibles y bioseguridad, con despachos diarios desde Buga.
      </p>
      <div class="actions">
        <a class="btn btn--wa" href={waLink('quote')} target="_blank" rel="noopener" data-wa-primary>
          <Icon name="whatsapp" size={22} />
          Cotizar por WhatsApp
        </a>
        <a class="link-action" href="#contacto">Usar el formulario <Icon name="arrow" size={18} /></a>
      </div>
      <p class="badge">
        <Icon name="truck" size={20} />
        <span>Entrega en <strong>{deliveryTime}</strong> si el producto está en inventario</span>
      </p>
    </div>

    <ul class="stats">
      {stats.map((s) => (
        <li class="card stat">
          <span class="stat__icon"><Icon name={s.icon} size={20} /></span>
          <span class="stat__text">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(1200px 500px at 100% 0%, var(--green-50), transparent 60%),
      linear-gradient(180deg, var(--blue-50), #fff 85%);
    padding-block: clamp(28px, 7vw, 88px) clamp(32px, 6vw, 64px);
  }

  .hero__copy {
    max-width: 720px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--green-50);
    border: 1px solid var(--green-line);
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .badge :global(svg) {
    flex: none;
    color: var(--green-700);
  }

  .stats {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0.8rem;
  }

  .stat__icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--blue-50);
    color: var(--blue-700);
  }

  .stat__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stat strong {
    font-size: clamp(1.1rem, 4.2vw, 1.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--blue-700);
  }

  .stat__text span {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .stat__text span {
      font-size: 0.9rem;
    }
  }
</style>
