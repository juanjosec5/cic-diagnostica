---
// The catalog UI, shared by /catalogo/ and /catalogo/[categoria]/. The server renders a first list (so the page
// works and is indexed without JS); the script then loads /catalogo/productos.json and adds search, filters and
// the quote list. Rows are built from a <template> with textContent only, never innerHTML.
import Icon from './Icon.astro';
import { categoriaPath, categorias, formatDate, segmentos, total, updatedAt, type Producto } from '../lib/catalog';
import { MAX_LIST_ITEMS, MAX_QTY } from '../lib/catalog-search';
import { company, municipalities } from '../data/site';
import { waTextLink } from '../lib/whatsapp';

interface Props {
  title: string;
  intro: string;
  /** Rows rendered on the server. */
  initial: Producto[];
  /** Set on a category page: that pill starts selected. */
  categoria?: string;
}
const { title, intro, initial, categoria } = Astro.props;
const label = (slug: string) => categorias.find((c) => c.slug === slug)?.label ?? slug;
---

<section
  class="catalog container"
  data-categoria={categoria}
  data-wa-base={waTextLink('')}
  data-response-time={company.responseTime}
  data-max-items={MAX_LIST_ITEMS}>
  <header class="catalog__head">
    <nav class="crumbs" aria-label="Ruta">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span>
      {categoria ? <a href="/catalogo/">Catálogo</a> : <span aria-current="page">Catálogo</span>}
      {categoria && (<><span aria-hidden="true">/</span> <span aria-current="page">{label(categoria)}</span></>)}
    </nav>
    <h1>{title}</h1>
    <p class="lead">{intro}</p>
    <p class="facts">Sin pedido mínimo · Entrega gratis en {municipalities.length} municipios del Valle</p>
    <p class="updated">
      {!categoria && `${total.toLocaleString('es-CO')} referencias · `}Catálogo actualizado el {formatDate(updatedAt)}
    </p>
  </header>

  <!-- Hidden until the script runs: without JS there's nothing to search, the category links below still work. -->
  <div class="tools" hidden data-tools>
    <!-- Results update while typing; the keyboard's "Buscar" key submits, which closes it and shows the results. -->
    <form class="search" role="search" data-search>
      <label class="visually-hidden" for="catalog-q">Buscar por nombre, marca o código</label>
      <Icon name="search" size={20} />
      <input id="catalog-q" type="search" placeholder="Ej.: guantes, jeringa 5 ml" autocomplete="off" enterkeyhint="search" />
    </form>
    <label class="seg">
      <span class="visually-hidden">Especialidad</span>
      <select id="catalog-seg">
        <option value="">Todas las especialidades</option>
        {segmentos.map((s) => <option value={s.slug}>{s.label}</option>)}
      </select>
    </label>
  </div>

  <nav class="pills" aria-label="Categorías">
    <ul>
      {categorias.map((c) => (
        <li>
          <a href={categoriaPath(c.slug)} class="pill" data-cat={c.slug} aria-current={c.slug === categoria ? 'page' : undefined}>
            <span class="pill__check" aria-hidden="true"><Icon name="check" size={16} /></span>
            {c.label} <span class="pill__count">{c.count}</span>
          </a>
        </li>
      ))}
    </ul>
    <button class="pills__toggle link-action" type="button" aria-expanded="false" hidden data-pills-toggle>
      Ver todas las categorías ({categorias.length})
    </button>
  </nav>

  <div class="status-row">
    <p class="status" role="status" data-status>
      {categoria ? `${initial.length} productos` : `Mostrando ${initial.length} de ${total.toLocaleString('es-CO')} productos`}
    </p>
    <button class="link-action" type="button" hidden data-clear-filters>Limpiar filtros</button>
    <!-- PDF of the current results (with letterhead) for hospitals; needs a filter, see MAX_EXPORT_ITEMS. -->
    <a class="export" href="#" target="_blank" rel="noopener" aria-disabled="true" hidden data-export>
      <Icon name="download" size={20} />
    </a>
    <p class="export__hint" role="status" hidden data-export-hint></p>
  </div>

  <ul class="results" data-results>
    {initial.map((p) => (
      <li class="row">
        <div class="row__main">
          <span class="row__name">{p.nombre}</span>
          <span class="row__meta">
            Cód. {p.cod} · {label(p.categoria)}
            {p.bajoPedido && <span class="badge">Bajo pedido</span>}
          </span>
        </div>
      </li>
    ))}
  </ul>

  <!-- Three cases (see renderEmpty): filters only, a term found elsewhere in the catalog, a term found nowhere. -->
  <div class="empty" hidden data-empty>
    <p data-empty-text></p>
    <div class="empty__actions">
      <button class="btn btn--primary" type="button" hidden data-empty-all></button>
      <a class="btn btn--wa" data-empty-wa href="#" target="_blank" rel="noopener" hidden>
        <Icon name="whatsapp" size={20} /> Preguntar por WhatsApp
      </a>
    </div>
  </div>

  <button class="btn btn--primary more" type="button" hidden data-more>Ver más productos</button>

  <template data-row>
    <li class="row">
      <div class="row__main">
        <span class="row__name"></span>
        <span class="row__meta"><span data-meta></span><span class="badge" hidden>Bajo pedido</span></span>
      </div>
      <!-- "Agregar" until the product is in the list, then its quantity stepper (see syncRow). -->
      <div class="row__action">
        <button class="row__add" type="button"><Icon name="plus" size={18} /> Agregar</button>
      </div>
    </li>
  </template>

  <!-- Quantity of a listed product, on its row and in the list dialog. At 1, "−" becomes a trash can: it removes it. -->
  <template data-qty>
    <div class="qty" role="group">
      <button class="qty__btn" type="button" data-dec>
        <span class="qty__trash"><Icon name="trash" size={18} /></span>
        <span class="qty__minus"><Icon name="minus" size={18} /></span>
      </button>
      <input class="qty__input" type="text" inputmode="numeric" pattern="[0-9]*" maxlength={String(MAX_QTY).length} autocomplete="off" data-qty-input />
      <button class="qty__btn" type="button" data-inc><Icon name="plus" size={18} /></button>
    </div>
  </template>

  <!-- Quote list: a bar while it has items, a dialog to review it. -->
  <div class="quote-bar" hidden data-bar>
    <button class="quote-bar__open" type="button" data-open-list>
      Ver lista (<span data-count>0</span>)
    </button>
    <a class="btn btn--wa" href="#" target="_blank" rel="noopener" data-send>
      <Icon name="whatsapp" size={20} /> <span>Cotizar<span class="wide"> por WhatsApp</span></span>
    </a>
  </div>

  <dialog class="quote" aria-labelledby="quote-title" data-dialog>
    <!-- The padding is on this wrapper, so a click on the dialog element itself is always the backdrop. -->
    <div class="quote__inner">
      <div class="quote__head">
        <h2 id="quote-title">Su lista para cotizar</h2>
        <button class="quote__close" type="button" aria-label="Cerrar" data-close><Icon name="close" /></button>
      </div>
      <p class="quote__hint">Ajuste las cantidades y envíe la lista. Le respondemos en menos de {company.responseTime}.</p>
      <ul class="quote__items" data-list></ul>
      <p class="quote__limit" hidden data-limit>Llegó a {MAX_LIST_ITEMS} productos, el máximo por mensaje. Envíe esta lista y luego arme otra.</p>
      <div class="quote__actions">
        <a class="btn btn--wa" href="#" target="_blank" rel="noopener" data-send>
          <Icon name="whatsapp" size={20} /> Enviar lista por WhatsApp
        </a>
        <button class="link-action" type="button" data-clear>Vaciar lista</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import {
    MAX_LIST_ITEMS,
    MAX_QTY,
    clampQty,
    describeFilters,
    exportProblem,
    filterItems,
    hasFilters,
    matcher,
    quoteMessage,
    readFilters,
    readSavedList,
    toItems,
    writeFilters,
    type CatalogPayload,
    type Filters,
    type Item,
    type ListEntry,
  } from '../lib/catalog-search';
  import { track } from '../lib/track';

  const PAGE = 50;
  const STORAGE_KEY = 'cic-catalog-list';

  const root = document.querySelector<HTMLElement>('.catalog')!;
  const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const q = $<HTMLInputElement>('#catalog-q');
  const segSelect = $<HTMLSelectElement>('#catalog-seg');
  const results = $<HTMLUListElement>('[data-results]');
  const status = $('[data-status]');
  const more = $<HTMLButtonElement>('[data-more]');
  const empty = $('[data-empty]');
  const rowTpl = $<HTMLTemplateElement>('template[data-row]');
  const bar = $('[data-bar]');
  const dialog = $<HTMLDialogElement>('[data-dialog]');
  const listEl = $<HTMLUListElement>('[data-list]');
  const waBase = root.dataset.waBase!;

  let data: CatalogPayload;
  let items: Item[] = [];
  let byCod = new Map<string, Item>();
  const selectedCats = new Set<number>();
  let shown = PAGE;
  let filtered: Item[] = [];
  const catIndex = (slug: string | undefined) => data.categorias.findIndex((c) => c.slug === slug);

  // --- Quote list (persisted per browser; storage can be unavailable in private mode) ---
  const list: ListEntry[] = (() => {
    try {
      return readSavedList(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
    } catch {
      return [];
    }
  })();
  const saveList = () => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    } catch {
      /* the list still works for this visit */
    }
  };

  const entry = (cod: string) => list.find((e) => e.cod === cod);
  // Empty until the catalog loads (byCod), so nothing acts on a list it can't show.
  const listItems = () =>
    list.flatMap((e) => {
      const p = byCod.get(e.cod);
      return p ? [{ ...p, qty: e.qty }] : [];
    });
  const sendHref = () => waBase + encodeURIComponent(quoteMessage(listItems()));
  const qtyTpl = $<HTMLTemplateElement>('template[data-qty]');

  /** Bar, send links and limit note: everything that depends on the list but not on which rows are shown. */
  function renderSummary() {
    const n = list.length;
    bar.hidden = n === 0;
    $('[data-count]').textContent = String(n);
    root.querySelectorAll<HTMLAnchorElement>('[data-send]').forEach((a) => (a.href = sendHref()));
    $('[data-limit]').hidden = n < MAX_LIST_ITEMS;
  }

  /** After a product is added or removed: rebuild the dialog list and update every visible row. */
  function renderList() {
    const current = listItems();
    // Codes that left the catalog after a refresh are dropped quietly.
    if (current.length !== list.length) {
      list.splice(0, list.length, ...current.map((p) => ({ cod: p.cod, qty: p.qty })));
      saveList();
    }
    renderSummary();
    listEl.replaceChildren(
      ...current.map((p) => {
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.textContent = `${p.cod} · ${p.nombre}`;
        li.append(name, stepper(p));
        return li;
      }),
    );
    if (!list.length && dialog.open) dialog.close();
    results.querySelectorAll<HTMLLIElement>('.row').forEach(syncRow);
  }

  function stepper(p: Item) {
    const group = qtyTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    group.dataset.cod = p.cod;
    group.dataset.nombre = p.nombre;
    group.setAttribute('aria-label', `Cantidad de ${p.nombre}`);
    group.querySelector('[data-qty-input]')!.setAttribute('aria-label', `Cantidad de ${p.nombre}`);
    group.querySelector('[data-inc]')!.setAttribute('aria-label', `Sumar uno a ${p.nombre}`);
    syncStepper(group);
    return group;
  }

  function syncStepper(group: HTMLElement) {
    const qty = entry(group.dataset.cod!)?.qty ?? 1;
    const input = group.querySelector<HTMLInputElement>('[data-qty-input]')!;
    if (document.activeElement !== input) input.value = String(qty); // don't fight someone typing
    group.classList.toggle('is-one', qty === 1);
    const dec = group.querySelector('[data-dec]')!;
    dec.setAttribute('aria-label', qty === 1 ? `Quitar ${group.dataset.nombre}` : `Restar uno a ${group.dataset.nombre}`);
    group.querySelector<HTMLButtonElement>('[data-inc]')!.disabled = qty >= MAX_QTY;
  }

  /** A result row shows "Agregar" or, once listed, the stepper. */
  function syncRow(li: HTMLLIElement) {
    const cod = li.dataset.cod;
    const slot = li.querySelector<HTMLElement>('.row__action');
    if (!cod || !slot) return; // a server-rendered row, before the script replaces the list
    const add = slot.querySelector<HTMLButtonElement>('.row__add')!;
    const existing = slot.querySelector<HTMLElement>('.qty');
    if (entry(cod)) {
      add.hidden = true;
      if (existing) syncStepper(existing);
      else slot.append(stepper(byCod.get(cod)!));
    } else {
      existing?.remove();
      add.hidden = false;
      add.disabled = list.length >= MAX_LIST_ITEMS;
    }
  }

  function add(cod: string) {
    if (entry(cod) || list.length >= MAX_LIST_ITEMS) return;
    list.push({ cod, qty: 1 });
    track('add_to_cart', { items: [{ item_id: cod, quantity: 1 }] });
    saveList();
    renderList();
    // Keep keyboard focus on the row: "Agregar" just turned into the stepper.
    results.querySelector<HTMLElement>(`.row[data-cod="${CSS.escape(cod)}"] [data-inc]`)?.focus({ preventScroll: true });
  }

  function remove(cod: string) {
    const i = list.findIndex((e) => e.cod === cod);
    if (i < 0) return;
    list.splice(i, 1);
    saveList();
    renderList();
  }

  /** A quantity change keeps the DOM (and the focused input) and updates the stepper on its row and in the dialog. */
  function setQty(cod: string, qty: number) {
    const e = entry(cod);
    if (!e) return;
    e.qty = clampQty(qty);
    saveList();
    root.querySelectorAll<HTMLElement>(`.qty[data-cod="${CSS.escape(cod)}"]`).forEach(syncStepper);
    renderSummary();
  }

  // One set of handlers for every stepper, on the rows and in the dialog.
  root.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    // Tapping the number selects it, so typing replaces it (a tap places the caret after focus, undoing focusin's select).
    if (target.matches('[data-qty-input]')) {
      (target as HTMLInputElement).select();
      return;
    }
    const addBtn = target.closest<HTMLElement>('.row__add');
    if (addBtn) return add(addBtn.closest<HTMLElement>('.row')!.dataset.cod!);
    const group = target.closest<HTMLElement>('.qty');
    if (!group) return;
    const cod = group.dataset.cod!;
    const qty = entry(cod)?.qty ?? 1;
    if (target.closest('[data-inc]')) setQty(cod, qty + 1);
    else if (target.closest('[data-dec]')) {
      if (qty <= 1) remove(cod);
      else setQty(cod, qty - 1);
    }
  });
  const qtyInputOf = (e: Event) => (e.target as HTMLElement).closest<HTMLInputElement>('[data-qty-input]');
  root.addEventListener('input', (e) => {
    const input = qtyInputOf(e);
    if (!input) return;
    input.value = input.value.replace(/\D/g, '');
    if (input.value) setQty(input.closest<HTMLElement>('.qty')!.dataset.cod!, Number(input.value));
  });
  // Leaving the field shows the stored quantity again (an empty or 0 entry falls back to it, never removes).
  root.addEventListener('focusout', (e) => {
    const input = qtyInputOf(e);
    if (input) requestAnimationFrame(() => syncStepper(input.closest<HTMLElement>('.qty')!));
  });
  root.addEventListener('keydown', (e) => {
    const input = qtyInputOf(e);
    if (input && e.key === 'Enter') input.blur(); // closes the phone keyboard
  });
  root.addEventListener('focusin', (e) => {
    qtyInputOf(e)?.select();
  });

  // --- Results ---
  function row(p: Item) {
    const li = rowTpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    li.querySelector('.row__name')!.textContent = p.nombre;
    li.querySelector('[data-meta]')!.textContent = `Cód. ${p.cod} · ${data.categorias[p.cat].label}`;
    (li.querySelector('.badge') as HTMLElement).hidden = !p.bajoPedido;
    li.dataset.cod = p.cod;
    li.querySelector('.row__add')!.setAttribute('aria-label', `Agregar ${p.nombre} a la lista`);
    syncRow(li);
    return li;
  }

  const current = (): Filters => ({
    query: q.value,
    cats: selectedCats,
    seg: data.segmentos.findIndex((s) => s.slug === segSelect.value),
  });

  function applyFilters() {
    const { base, results: ordered } = filterItems(items, data.categorias, current());
    updatePillCounts(base);
    filtered = ordered;
    shown = PAGE;
    render();
    syncUrl();
  }

  function render() {
    results.replaceChildren(...filtered.slice(0, shown).map(row));
    more.hidden = filtered.length <= shown;
    const n = filtered.length.toLocaleString('es-CO');
    const count = filtered.length > shown ? `Mostrando ${shown} de ${n} productos` : `${n} productos`;
    // Active filters spelled out (the search term is already in the box): on phones selected pills can be off screen.
    const active = describeFilters({ ...current(), query: '' }, data);
    status.textContent = [count, ...active].join(' · ');
    $('[data-clear-filters]').hidden = !hasFilters(current());
    empty.hidden = filtered.length > 0;
    if (!filtered.length) renderEmpty();
    renderExport();
  }

  const exportLink = $<HTMLAnchorElement>('[data-export]');
  const exportHint = $('[data-export-hint]');
  let exportReason = '';
  function renderExport() {
    const n = filtered.length;
    exportReason = exportProblem(current(), n);
    const label = exportReason || `Descargar PDF (${n.toLocaleString('es-CO')} productos)`;
    exportLink.hidden = false;
    exportLink.title = label;
    exportLink.setAttribute('aria-label', label);
    exportLink.setAttribute('aria-disabled', String(!!exportReason));
    exportLink.href = exportReason ? '#' : `/catalogo/imprimir/?${writeFilters(new URLSearchParams(), current(), data)}`;
    exportHint.hidden = true;
  }
  let hintTimer: number | undefined;
  exportLink.addEventListener('click', (e) => {
    if (!exportReason) return track('export_pdf', { items: filtered.length });
    e.preventDefault(); // disabled: say why (the title tooltip doesn't show on phones)
    exportHint.textContent = exportReason;
    exportHint.hidden = false;
    clearTimeout(hintTimer);
    hintTimer = window.setTimeout(() => (exportHint.hidden = true), 3000);
  });

  function renderEmpty() {
    const term = q.value.trim();
    const text = $('[data-empty-text]');
    const all = $<HTMLButtonElement>('[data-empty-all]');
    const wa = $<HTMLAnchorElement>('[data-empty-wa]');
    const match = matcher(term);
    const elsewhere = term ? items.filter((p) => match(p.key)).length : 0;
    all.hidden = !!term && !elsewhere;
    wa.hidden = !term || elsewhere > 0;
    if (!term) {
      text.textContent = 'No hay productos con estos filtros.';
      all.textContent = 'Quitar filtros';
    } else if (elsewhere) {
      text.textContent = `«${term}» no aparece con estos filtros.`;
      all.textContent = elsewhere === 1 ? 'Ver el resultado en todo el catálogo' : `Ver los ${elsewhere} resultados en todo el catálogo`;
    } else {
      // A search with no results is still a lead: offer to ask for it by name.
      text.textContent = `«${term}» no aparece en el catálogo, pero puede que lo tengamos. Pregúntenos por WhatsApp y le respondemos en menos de ${root.dataset.responseTime}.`;
      wa.href = waBase + encodeURIComponent(`Hola, ¿tienen ${term}? No lo encontré en el catálogo. (web-catalogo)\nCantidad y municipio: `);
    }
  }

  // Keeps the search term, drops categories and specialty.
  function clearFilters({ keepSearch = true } = {}) {
    selectedCats.clear();
    segSelect.value = '';
    if (!keepSearch) q.value = '';
    syncPills();
    applyFilters();
  }

  function updatePillCounts(base: Item[]) {
    const counts = new Array(data.categorias.length).fill(0);
    base.forEach((p) => counts[p.cat]++);
    root.querySelectorAll<HTMLAnchorElement>('.pill').forEach((pill) => {
      const i = catIndex(pill.dataset.cat);
      pill.querySelector('.pill__count')!.textContent = String(counts[i]);
      // A selected pill stays visible (even at 0) so it can be unselected.
      pill.parentElement!.hidden = counts[i] === 0 && !selectedCats.has(i);
    });
    updatePillsToggle();
  }

  function syncPills() {
    root.querySelectorAll<HTMLAnchorElement>('.pill').forEach((pill) => {
      pill.setAttribute('aria-pressed', String(selectedCats.has(catIndex(pill.dataset.cat))));
      pill.removeAttribute('aria-current');
    });
  }

  // Filters live in the URL so a filtered view can be shared (e.g. pasted in WhatsApp).
  // Other parameters (utm_*, gclid…) are kept, so campaign attribution survives.
  function syncUrl() {
    const params = new URLSearchParams(location.search);
    const f = current();
    // One category and nothing else is exactly a category page: keep that clean URL.
    const only = f.cats.size === 1 && !f.query.trim() && f.seg < 0 ? data.categorias[[...f.cats][0]].slug : '';
    writeFilters(params, only ? { ...f, cats: new Set() } : f, data);
    const qs = params.toString(); // not params.size: missing before Safari 17
    const path = `/catalogo/${only ? `${only}/` : ''}${qs ? `?${qs}` : ''}`;
    if (path !== location.pathname + location.search) history.replaceState(null, '', path);
  }

  let searchTimer: number | undefined;
  let trackTimer: number | undefined;
  q.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = window.setTimeout(applyFilters, 120);
    // Report the search once the visitor stops typing; zero-result searches show demand we don't cover.
    clearTimeout(trackTimer);
    trackTimer = window.setTimeout(() => {
      const term = q.value.trim();
      if (term.length >= 3) track('search', { search_term: term, results: filtered.length });
    }, 1500);
  });
  segSelect.addEventListener('change', applyFilters);

  // On phones the keyboard covers the results (and the "Preguntar por WhatsApp" button when nothing matches).
  $<HTMLFormElement>('[data-search]').addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(searchTimer);
    applyFilters();
    q.blur();
    (filtered.length ? status : empty).scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  root.querySelector('.pills')!.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest<HTMLAnchorElement>('.pill');
    if (!pill || !data) return;
    e.preventDefault(); // with JS, pills toggle (and mix); without it they're links to the category pages
    const i = catIndex(pill.dataset.cat);
    if (selectedCats.has(i)) selectedCats.delete(i);
    else selectedCats.add(i);
    syncPills();
    applyFilters();
    // Phones move selected pills to the front of the swipe row: scroll there so the tapped one stays in view.
    if (matchMedia('(max-width: 639px)').matches) pillsList.scrollTo({ left: 0, behavior: 'smooth' });
  });


  more.addEventListener('click', () => {
    shown += PAGE;
    render();
  });

  // Wider screens show two rows of pills; the rest open with the toggle (phones scroll the row instead).
  const pillsList = $('.pills ul');
  const pillsToggle = $<HTMLButtonElement>('[data-pills-toggle]');
  const setPillsOpen = (open: boolean) => {
    pillsList.classList.toggle('is-open', open);
    pillsToggle.setAttribute('aria-expanded', String(open));
    updatePillsToggle();
  };
  pillsToggle.addEventListener('click', () => setPillsOpen(!pillsList.classList.contains('is-open')));
  // Tabbing into a pill in the collapsed rows would scroll the list inside its box: open it instead.
  // Only for keyboard focus on a pill that is actually cut off: a mouse click on a visible pill must not open them all.
  pillsList.addEventListener('focusin', (e) => {
    const pill = e.target as HTMLElement;
    if (pillsToggle.hidden || pillsList.classList.contains('is-open') || !pill.matches(':focus-visible')) return;
    // Position within the list's content: focusing a cut-off pill scrolls the list box itself, so compare against the
    // visible height rather than where it is on screen right now.
    const bottom = pill.getBoundingClientRect().bottom - pillsList.getBoundingClientRect().top + pillsList.scrollTop;
    if (bottom > pillsList.clientHeight) {
      setPillsOpen(true);
      pillsList.scrollTop = 0;
    }
  });
  function updatePillsToggle() {
    const open = pillsList.classList.contains('is-open');
    const visible = pillsList.querySelectorAll('li:not([hidden])').length;
    pillsToggle.textContent = open ? 'Ver menos categorías' : `Ver todas las categorías (${visible})`;
    pillsToggle.hidden = !open && pillsList.scrollHeight <= pillsList.clientHeight + 1;
  }
  // Phones: the pill row fades at the right edge to show it scrolls; no fade once at the end.
  const syncPillsFade = () =>
    pillsList.classList.toggle('at-end', pillsList.scrollLeft + pillsList.clientWidth >= pillsList.scrollWidth - 4);
  pillsList.addEventListener('scroll', syncPillsFade, { passive: true });

  function initPillsToggle() {
    syncPillsFade();
    updatePillsToggle();
    // Don't hide a selected category behind the toggle.
    const top = pillsList.getBoundingClientRect().bottom;
    const hiddenSelected = [...pillsList.querySelectorAll('.pill[aria-pressed="true"]')].some((el) => el.getBoundingClientRect().top >= top);
    if (hiddenSelected) setPillsOpen(true);
  }

  $('[data-clear-filters]').addEventListener('click', () => clearFilters({ keepSearch: false }));
  $('[data-empty-all]').addEventListener('click', () => clearFilters());

  // The header's "Cotizar" sends a generic message; with a list started, open the list instead so it isn't lost.
  // listItems() is empty until the catalog loads, so a failed or slow load leaves the normal link working.
  document.querySelector('.header__wa')?.addEventListener('click', (e) => {
    if (!listItems().length) return;
    e.preventDefault();
    dialog.showModal();
  });

  $('[data-open-list]').addEventListener('click', () => dialog.showModal());
  $('[data-close]').addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close(); // click on the backdrop
  });
  $('[data-clear]').addEventListener('click', () => {
    list.length = 0;
    saveList();
    renderList();
  });
  root.querySelectorAll('[data-send]').forEach((a) =>
    a.addEventListener('click', () =>
      track('generate_lead', { method: 'whatsapp', items: list.length, units: list.reduce((n, e) => n + e.qty, 0) }),
    ),
  );

  async function init() {
    try {
      const res = await fetch('/catalogo/productos.json');
      if (!res.ok) throw new Error(String(res.status));
      data = await res.json();
    } catch {
      return; // the server-rendered list and category links keep working
    }
    items = toItems(data);
    byCod = new Map(items.map((p) => [p.cod, p]));

    const initial = readFilters(new URLSearchParams(location.search), data, root.dataset.categoria);
    initial.cats.forEach((i) => selectedCats.add(i));
    q.value = initial.query;
    segSelect.value = initial.seg >= 0 ? data.segmentos[initial.seg].slug : '';

    $('[data-tools]').hidden = false;
    syncPills();
    initPillsToggle();
    renderList();
    applyFilters();
  }
  init();
</script>

