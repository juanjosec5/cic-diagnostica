---
import Icon from './Icon.astro';
import { stats } from '../data/site';
import { waLink } from '../lib/whatsapp';
---

<section id="inicio" class="hero">
  <div class="container">
    <div class="hero__copy">
      <span class="eyebrow">Distribuidora de insumos médicos y de laboratorio</span>
      <h1>Reactivos e insumos de laboratorio, a tiempo en el suroccidente colombiano</h1>
      <p class="lead">
        Somos una distribuidora independiente de insumos médicos y de laboratorio con sede en Buga. Como proveedores
        del laboratorio clínico CIC y de la clínica Sane, sabemos lo que significa quedarse sin insumos. Por eso
        llevamos sus pedidos con personal y vehículos propios.
      </p>
      <div class="hero__actions">
        <a class="btn btn--wa" href={waLink('quote')} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={22} />
          Cotizar por WhatsApp
        </a>
        <a class="btn btn--outline" href="#contacto">Enviar una solicitud</a>
      </div>
    </div>

    <dl class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(1200px 500px at 100% 0%, var(--green-50), transparent 60%),
      linear-gradient(180deg, var(--blue-50), #fff 85%);
    padding-block: clamp(40px, 8vw, 96px) clamp(40px, 6vw, 72px);
  }

  .hero__copy {
    max-width: 720px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__actions .btn {
    flex: 1 1 220px;
  }

  @media (min-width: 640px) {
    .hero__actions .btn {
      flex: 0 0 auto;
    }
  }

  .stats {
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .stat dd {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--blue-700);
  }

  .stat dt {
    color: var(--muted);
    font-size: 0.925rem;
  }
</style>
