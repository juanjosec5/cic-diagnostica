---
import Icon from './Icon.astro';
import { clientPlans, municipalities } from '../data/site';
---

<section id="clientes" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Condiciones por tipo de cliente</span>
      <h2>¿Qué tipo de cliente es usted?</h2>
    </div>

    <ul class="tiles">
      {clientPlans.map((plan) => (
        <li class="card tile">
          <div class="tile__head">
            <span class="icon-badge"><Icon name={plan.icon} /></span>
            <h3>{plan.title}</h3>
          </div>
          <ul class="tile__list">
            {plan.benefits.map((b) => (
              <li>
                <Icon name="check" size={16} />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          {plan.link && (
            <a class="link-action tile__link" href={plan.link.href}>
              {plan.link.text} <Icon name="arrow" size={18} />
            </a>
          )}
        </li>
      ))}
    </ul>

    <!-- No WhatsApp button here: the hero, the cards above and the floating button already offer one. -->
    <p class="plans__all">
      <Icon name="check" size={18} />
      <span>Para todos: sin pedido mínimo y entrega gratis en {municipalities.length} municipios.</span>
    </p>
  </div>
</section>

<style>
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1040px) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    padding: 1rem;
  }

  .tile__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tile__head .icon-badge {
    margin: 0;
    flex: none;
  }

  .tile__head h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .tile__list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .tile__list li {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
  }

  .tile__list :global(svg) {
    flex: none;
    margin-top: 0.25rem;
    color: var(--green-700);
  }

  .tile__link {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .plans__all {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    font-weight: 600;
    text-align: center;
  }

  .plans__all :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--green-700);
  }
</style>
