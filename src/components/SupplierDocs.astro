---
import Icon from './Icon.astro';
import { supplierDocuments } from '../data/site';
---

<section id="documentos" class="section docs-section">
  <div class="container">
    <div class="card docs">
      <div>
        <span class="eyebrow">Documentos para proveedor</span>
        <h2>¿Necesita inscribirnos como proveedor?</h2>
        <p class="docs__line">
          Se los enviamos por correo en 48 horas hábiles. Los registros INVIMA y las fichas técnicas son los de cada
          fabricante. También participamos en licitaciones públicas.
        </p>
      </div>
      <ul class="doc-tiles">
        {supplierDocuments.map((doc) => (
          <li>
            <Icon name="file" size={26} />
            <span>{doc}</span>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary docs__cta" href="#contacto" data-interest="documentos">
        Solicitar documentos
        <Icon name="arrow" size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  .docs-section {
    padding-top: 0;
    background: var(--bg-soft);
  }

  .docs {
    display: grid;
    gap: 1rem 2.5rem;
    padding: clamp(1.1rem, 4vw, 2rem);
  }

  /* Full width with tighter padding so the label stays on one line, even with enlarged phone text. */
  .docs__cta {
    width: 100%;
    padding-inline: 0.75rem;
  }

  @media (min-width: 900px) {
    .docs {
      grid-template-columns: 2fr 3fr;
      align-items: center;
    }
    .docs__cta {
      grid-column: 1;
      justify-self: start;
      width: auto;
      padding-inline: 1.25rem;
    }
  }

  .docs h2 {
    font-size: clamp(1.3rem, 3.5vw, 1.6rem);
  }

  .docs__line {
    margin: 0;
    color: var(--muted);
  }

  .doc-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  @media (min-width: 900px) {
    .doc-tiles {
      grid-row: span 2;
    }
  }

  .doc-tiles li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 0.8rem;
    border-radius: 12px;
    background: var(--blue-50);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--blue-900);
  }

  .doc-tiles :global(svg) {
    color: var(--blue-700);
  }
</style>
