---
import Icon from './Icon.astro';
import { waLink } from '../lib/whatsapp';
---

<a class="wa-float" href={waLink('general')} target="_blank" rel="noopener" aria-label="Escríbanos por WhatsApp">
  <Icon name="whatsapp" size={30} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 16px;
    /* --consent-h lifts the button above the consent banner while it's open. */
    bottom: calc(16px + var(--consent-h, 0px) + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--wa);
    color: #fff;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
    transition: transform 0.15s;
  }

  .wa-float:hover {
    transform: scale(1.06);
  }

  .wa-float:focus-visible {
    outline: 3px solid var(--blue-900);
    outline-offset: 3px;
    border-radius: 50%;
  }

  .wa-float.is-hidden {
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wa-float {
      transition: transform 0.15s, opacity 0.2s;
    }
  }

  /* Desktop shows "Cotizar" in the header instead. */
  @media (min-width: 640px) {
    .wa-float {
      display: none;
    }
  }
</style>

<script>
  // Hide the floating button while a section's own WhatsApp button ([data-wa-primary]) is visible,
  // so two green WhatsApp buttons never compete on the same screen.
  const float = document.querySelector<HTMLAnchorElement>('.wa-float');
  const primaries = document.querySelectorAll('[data-wa-primary]');
  if (float && primaries.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target);
        else visible.delete(e.target);
      }
      const hide = visible.size > 0;
      float.classList.toggle('is-hidden', hide);
      float.tabIndex = hide ? -1 : 0;
    });
    primaries.forEach((el) => io.observe(el));
  }
</script>
